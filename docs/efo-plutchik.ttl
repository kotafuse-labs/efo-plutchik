    skos:definition "The low-intensity form of anger (outer ring of Plutchik's wheel)."@en ,
        "怒りの弱い形（Plutchik の wheel の外側の環）。"@ja ;
    plu:intensityOf plu:Anger ; plu:hasIntensityLevel plu:LowIntensity .
plu:Rage a owl:NamedIndividual , plu:IntensityVariant ;
    rdfs:label "Rage"@en , "激怒"@ja ;
    skos:definition "The high-intensity form of anger (inner ring of Plutchik's wheel)."@en ,
        "怒りの強い形（Plutchik の wheel の内側の環）。"@ja ;
    plu:intensityOf plu:Anger ; plu:hasIntensityLevel plu:HighIntensity .
plu:Interest a owl:NamedIndividual , plu:IntensityVariant ;
    rdfs:label "Interest"@en , "関心"@ja ;
    skos:definition "The low-intensity form of anticipation (outer ring of Plutchik's wheel)."@en ,
        "期待の弱い形（Plutchik の wheel の外側の環）。"@ja ;
    plu:intensityOf plu:Anticipation ; plu:hasIntensityLevel plu:LowIntensity .
plu:Vigilance a owl:NamedIndividual , plu:IntensityVariant ;
