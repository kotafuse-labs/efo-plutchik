#################### Primary dyads (8) ####################
plu:Love a owl:NamedIndividual , plu:PrimaryDyad ;
    rdfs:label "Love"@en , "愛"@ja ;
    skos:definition "The primary dyad of joy and trust (adjacent on the wheel)."@en ,
        "喜びと信頼の一次 dyad（wheel 上で隣り合う基本感情の組）。"@ja ;
    plu:hasComponentEmotion plu:Joy , plu:Trust .
plu:Submission a owl:NamedIndividual , plu:PrimaryDyad ;
    rdfs:label "Submission"@en , "服従"@ja ;
    skos:definition "The primary dyad of trust and fear (adjacent on the wheel)."@en ,
        "信頼と恐れの一次 dyad（wheel 上で隣り合う基本感情の組）。"@ja ;
    plu:hasComponentEmotion plu:Trust , plu:Fear .
plu:Awe a owl:NamedIndividual , plu:PrimaryDyad ;
    rdfs:label "Awe"@en , "畏怖"@ja ;
    skos:definition "The primary dyad of fear and surprise (adjacent on the wheel)."@en ,
        "恐れと驚きの一次 dyad（wheel 上で隣り合う基本感情の組）。"@ja ;
    plu:hasComponentEmotion plu:Fear , plu:Surprise .
plu:Disapproval a owl:NamedIndividual , plu:PrimaryDyad ;
    rdfs:label "Disapproval"@en , "不承認"@ja ;
    skos:definition "The primary dyad of surprise and sadness (adjacent on the wheel)."@en ,
        "驚きと悲しみの一次 dyad（wheel 上で隣り合う基本感情の組）。"@ja ;
    plu:hasComponentEmotion plu:Surprise , plu:Sadness .
plu:Remorse a owl:NamedIndividual , plu:PrimaryDyad ;
    rdfs:label "Remorse"@en , "自責"@ja ;
    skos:definition "The primary dyad of sadness and disgust (adjacent on the wheel)."@en ,
        "悲しみと嫌悪の一次 dyad（wheel 上で隣り合う基本感情の組）。"@ja ;
    plu:hasComponentEmotion plu:Sadness , plu:Disgust .
plu:Contempt a owl:NamedIndividual , plu:PrimaryDyad ;
    rdfs:label "Contempt"@en , "軽蔑"@ja ;
    skos:definition "The primary dyad of disgust and anger (adjacent on the wheel)."@en ,
        "嫌悪と怒りの一次 dyad（wheel 上で隣り合う基本感情の組）。"@ja ;
    plu:hasComponentEmotion plu:Disgust , plu:Anger .
plu:Aggressiveness a owl:NamedIndividual , plu:PrimaryDyad ;
    rdfs:label "Aggressiveness"@en , "攻撃性"@ja ;
    skos:definition "The primary dyad of anger and anticipation (adjacent on the wheel)."@en ,
        "怒りと期待の一次 dyad（wheel 上で隣り合う基本感情の組）。"@ja ;
    plu:hasComponentEmotion plu:Anger , plu:Anticipation .
plu:Optimism a owl:NamedIndividual , plu:PrimaryDyad ;
    rdfs:label "Optimism"@en , "楽観"@ja ;
    skos:definition "The primary dyad of anticipation and joy (adjacent on the wheel)."@en ,
        "期待と喜びの一次 dyad（wheel 上で隣り合う基本感情の組）。"@ja ;
    plu:hasComponentEmotion plu:Anticipation , plu:Joy .

#################### Secondary dyads (8) ####################
plu:Guilt a owl:NamedIndividual , plu:SecondaryDyad ;
    rdfs:label "Guilt"@en , "罪悪感"@ja ;
