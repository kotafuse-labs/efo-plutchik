    skos:definition "The low-intensity form of fear (outer ring of Plutchik's wheel)."@en ,
        "恐れの弱い形（Plutchik の wheel の外側の環）。"@ja ;
    plu:intensityOf plu:Fear ; plu:hasIntensityLevel plu:LowIntensity .
plu:Terror a owl:NamedIndividual , plu:IntensityVariant ;
    rdfs:label "Terror"@en , "恐怖"@ja ;
    skos:definition "The high-intensity form of fear (inner ring of Plutchik's wheel)."@en ,
        "恐れの強い形（Plutchik の wheel の内側の環）。"@ja ;
    plu:intensityOf plu:Fear ; plu:hasIntensityLevel plu:HighIntensity .
plu:Distraction a owl:NamedIndividual , plu:IntensityVariant ;
    rdfs:label "Distraction"@en , "放心"@ja ;
    skos:definition "The low-intensity form of surprise (outer ring of Plutchik's wheel)."@en ,
        "驚きの弱い形（Plutchik の wheel の外側の環）。"@ja ;
    plu:intensityOf plu:Surprise ; plu:hasIntensityLevel plu:LowIntensity .
plu:Amazement a owl:NamedIndividual , plu:IntensityVariant ;
    rdfs:label "Amazement"@en , "驚嘆"@ja ;
    skos:definition "The high-intensity form of surprise (inner ring of Plutchik's wheel)."@en ,
        "驚きの強い形（Plutchik の wheel の内側の環）。"@ja ;
    plu:intensityOf plu:Surprise ; plu:hasIntensityLevel plu:HighIntensity .
plu:Pensiveness a owl:NamedIndividual , plu:IntensityVariant ;
    rdfs:label "Pensiveness"@en , "哀愁"@ja ;
    skos:definition "The low-intensity form of sadness (outer ring of Plutchik's wheel)."@en ,
        "悲しみの弱い形（Plutchik の wheel の外側の環）。"@ja ;
    plu:intensityOf plu:Sadness ; plu:hasIntensityLevel plu:LowIntensity .
plu:Grief a owl:NamedIndividual , plu:IntensityVariant ;
    rdfs:label "Grief"@en , "悲嘆"@ja ;
    skos:definition "The high-intensity form of sadness (inner ring of Plutchik's wheel)."@en ,
        "悲しみの強い形（Plutchik の wheel の内側の環）。"@ja ;
    plu:intensityOf plu:Sadness ; plu:hasIntensityLevel plu:HighIntensity .
plu:Boredom a owl:NamedIndividual , plu:IntensityVariant ;
    rdfs:label "Boredom"@en , "退屈"@ja ;
