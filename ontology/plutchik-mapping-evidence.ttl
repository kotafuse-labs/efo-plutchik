@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix evd: <https://w3id.org/efo-plutchik/mapping/evidence#> .
@prefix map: <https://w3id.org/efo-plutchik/mapping#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/efo-plutchik/mapping/evidence> a owl:Ontology ;
    rdfs:label "EFO-Plutchik mapping evidence"@en,
        "EFO-Plutchik の写像の証拠"@ja ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "Evidence module 0.1.1. It adds cross-dataset transfer evidence for pairs of mapping records of the mapping module, which is unchanged."@en,
        "Generated by ontology/build_transfer_evidence.py; edit the script or the CSV, not this file."@en ;
    owl:imports <https://w3id.org/efo-plutchik/mapping> ;
    owl:versionInfo "0.1.1" .

evd:bestOtherAuc a owl:DatatypeProperty ;
    rdfs:label "best other AUC"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:decimal ;
    skos:definition "In each seed, the highest ROC-AUC among the source model's other labels (all labels except the name-matched one); these per-seed maxima are averaged, so the best label may differ between seeds. It is chosen after the fact, so it is an upper reference, not a usable predictor."@en .

evd:fromStudy a owl:ObjectProperty ;
    rdfs:label "from study"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range evd:EvidenceStudy ;
    skos:definition "The study that produced the evidence."@en .

evd:matchedAuc a owl:DatatypeProperty ;
    rdfs:label "matched AUC"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:decimal ;
    skos:definition "ROC-AUC of the source label's score against the target label's gold labels, averaged over seeds and rounded to 6 decimals."@en .

evd:nativeAuc a owl:DatatypeProperty ;
    rdfs:label "native AUC"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:decimal ;
    skos:definition "ROC-AUC of the target dataset's own model for the target label on its test split, averaged over seeds."@en .

evd:nativePositives a owl:DatatypeProperty ;
    rdfs:label "native positives"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of positive rows of the target label in the target dataset's test split. Below 20 the native AUC is unstable."@en .

evd:preregisteredVerdict a owl:ObjectProperty ;
    rdfs:label "pre-registered verdict"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range evd:Verdict ;
    skos:definition "Defined for five seeds. Supported: rank one in at least 4 of 5 seeds. Partial: within rank three in at least 4 of 5 seeds. NotSupported: otherwise. The rule has no absolute floor on the AUC."@en .

evd:rankOneSeeds a owl:DatatypeProperty ;
    rdfs:label "rank-one seeds"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of seeds in which the name-matched label had the highest AUC among the source model's labels."@en .

evd:rankThreeSeeds a owl:DatatypeProperty ;
    rdfs:label "rank-three seeds"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of seeds in which the name-matched label was among the three highest."@en .

evd:seedCount a owl:DatatypeProperty ;
    rdfs:label "seed count"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of seeds."@en .

evd:sourceLabelCount a owl:DatatypeProperty ;
    rdfs:label "source label count"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of labels of the source model. With few labels, rank three is easy to reach by chance."@en .

evd:sourceMapping a owl:ObjectProperty ;
    rdfs:label "source mapping"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range map:ConceptMapping ;
    skos:definition "The mapping record of the label the classifier was trained on."@en .

