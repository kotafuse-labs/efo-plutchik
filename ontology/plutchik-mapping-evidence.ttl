@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix evd: <https://w3id.org/efo-plutchik/mapping/evidence#> .
@prefix map: <https://w3id.org/efo-plutchik/mapping#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/efo-plutchik/mapping/evidence> a owl:Ontology ;
    rdfs:label "EFO-Plutchik mapping evidence"@en,
        "EFO-Plutchik の写像の証拠"@ja ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "Evidence module 0.3.0. It adds cross-dataset transfer evidence for pairs of mapping records of the mapping module. The evidence does not change any mapping record."@en,
        "Generated by ontology/build_transfer_evidence.py; edit the script or the CSV, not this file."@en ;
    owl:imports <https://w3id.org/efo-plutchik/mapping> ;
    owl:versionInfo "0.3.0" .

evd:bestOtherAuc a owl:DatatypeProperty ;
    rdfs:label "best other AUC"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:decimal ;
    skos:definition "In each seed, the highest ROC-AUC among the source model's other labels (all labels except the name-matched one); these per-seed maxima are averaged, so the best label may differ between seeds. It is chosen after the fact, so it is an upper reference, not a usable predictor."@en .

evd:bestOtherBasicAuc a owl:DatatypeProperty ;
    rdfs:label "best other basic-emotion AUC"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:decimal ;
    skos:definition "Recorded from study CrossDatasetTransfer2026c on, for pairs whose term is a basic emotion and whose source dataset has a label that maps to another basic emotion. In each seed, the highest ROC-AUC among the source model's labels that map to another basic emotion; these per-seed maxima are averaged. It never exceeds the best other AUC, because the set of rivals is smaller; a matched AUC above it is a weaker statement than a matched AUC above the best other AUC."@en .

evd:fromStudy a owl:ObjectProperty ;
    rdfs:label "from study"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range evd:EvidenceStudy ;
    skos:definition "The study that produced the evidence."@en .

evd:matchedAuc a owl:DatatypeProperty ;
    rdfs:label "matched AUC"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:decimal ;
    skos:definition "ROC-AUC of the source label's score against the target label's gold labels, averaged over seeds and rounded to 6 decimals."@en .

evd:mostFrequentBestOtherBasicMapping a owl:ObjectProperty ;
    rdfs:label "most frequent best other basic-emotion mapping"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range map:ConceptMapping ;
    skos:definition "The mapping record of the source dataset's label that most often (over seeds) had the highest AUC among the labels that map to another basic emotion; ties are broken by the label name. That is, among the source labels of other basic emotions, the one whose scores ranked the target label's rows best in this pair."@en .

evd:nativeAuc a owl:DatatypeProperty ;
    rdfs:label "native AUC"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:decimal ;
    skos:definition "ROC-AUC of the target dataset's own model for the target label on its test split, averaged over seeds. In study CrossDatasetTransfer2026c it is omitted when that split has fewer than 5 positive rows of the label (no label there has fewer than 5 negative rows)."@en .

evd:nativePositives a owl:DatatypeProperty ;
    rdfs:label "native positives"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of positive rows of the target label in the target dataset's test split. Below 20 the native AUC is unstable."@en .

evd:preregisteredVerdict a owl:ObjectProperty ;
    rdfs:label "pre-registered verdict"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range evd:Verdict ;
    skos:definition "Study CrossDatasetTransfer2026c: the rule of study CrossDatasetTransfer2026b, applied unchanged to the recorded (rounded) numbers; the study itself pre-registered only aggregate criteria, not a per-pair verdict. Study CrossDatasetTransfer2026b: Inconclusive if the source label had fewer than 50 training positives; otherwise Supported if rank one in at least 4 of 5 seeds and the matched AUC is at least 0.6; otherwise NotSupported if the matched AUC does not exceed the best other AUC; otherwise Mixed. Study CrossDatasetTransfer2026: defined for five seeds. Supported: rank one in at least 4 of 5 seeds. Partial: within rank three in at least 4 of 5 seeds. NotSupported: otherwise. The rule has no absolute floor on the AUC."@en .

evd:rankOneSeeds a owl:DatatypeProperty ;
    rdfs:label "rank-one seeds"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of seeds in which the name-matched label had the highest AUC among the source model's labels."@en .

evd:rankThreeSeeds a owl:DatatypeProperty ;
    rdfs:label "rank-three seeds"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of seeds in which the name-matched label was among the three highest."@en .

evd:seedCount a owl:DatatypeProperty ;
    rdfs:label "seed count"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of seeds."@en .

evd:sourceLabelCount a owl:DatatypeProperty ;
    rdfs:label "source label count"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of labels of the source model. With few labels, rank three is easy to reach by chance."@en .

evd:sourceMapping a owl:ObjectProperty ;
    rdfs:label "source mapping"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range map:ConceptMapping ;
    skos:definition "The mapping record of the label the classifier was trained on."@en .

evd:sourceTrainingPositives a owl:DatatypeProperty ;
    rdfs:label "source training positives"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of positive training rows of the source label (the minimum over seeds). Recorded from study CrossDatasetTransfer2026b on; the first study did not record it."@en .

