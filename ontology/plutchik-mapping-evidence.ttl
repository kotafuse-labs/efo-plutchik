evd:targetMapping a owl:ObjectProperty ;
    rdfs:label "target mapping"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range map:ConceptMapping ;
    skos:definition "The mapping record of the label the classifier was evaluated against."@en .

evd:targetPositives a owl:DatatypeProperty ;
    rdfs:label "target positives"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of positive rows of the target label among the evaluation rows."@en .

evd:targetRows a owl:DatatypeProperty ;
    rdfs:label "target rows"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of evaluation rows."@en .

evd:EvidenceStudy a owl:Class ;
    rdfs:label "Evidence study"@en,
        "証拠の調査"@ja ;
    skos:definition "An experiment that produced transfer evidence, with its setting and known limitations."@en .

evd:Verdict a owl:Class ;
    rdfs:label "Pre-registered verdict"@en,
        "事前登録の判定"@ja ;
    skos:definition "The per-pair verdict defined in the study's pre-registration. The rule differs between studies; see evd:preregisteredVerdict and the study's description."@en .

evd:Inconclusive a evd:Verdict ;
    rdfs:label "Inconclusive"@en .

evd:Mixed a evd:Verdict ;
    rdfs:label "Mixed"@en .

evd:Partial a evd:Verdict ;
    rdfs:label "Partial"@en .

evd:NotSupported a evd:Verdict ;
    rdfs:label "NotSupported"@en .

evd:CrossDatasetTransfer2026 a evd:EvidenceStudy ;
    rdfs:label "Cross-dataset transfer of name-matched labels (2026-11)"@en ;
    dcterms:date "2026-11-27"^^xsd:date ;
    dcterms:description "For each of 10 English emotion datasets a multi-label roberta-base classifier was trained on the dataset's own labels (learning rate 2e-5, at most 8,000 training rows, seeds 42-46) and applied to up to 5,000 fixed rows of every other dataset. A pair is included when both labels map to the same Plutchik term and the target label has at least 20 positive and 20 negative rows."@en ;
    dcterms:source "CombineEFOMoE issue #88 (pre-registered); mapping module 0.6.1 (the records of its 12 datasets are unchanged in 0.7.0)"@en,
        "sha256 020422159ecb66e90e5a54f9695a1ecf538296b1d0c459354858ec18dcaf971b scripts/export_transfer_evidence_csv.py"@en,
        "sha256 04bbf33b5e651cc8ad34589ba1766bed799ac1947018131ffb24c08aaa1742fd crossdata_transfer_supplement.json"@en,
        "sha256 19a560217dbaa535e1451c07008b43a821e4c1a4728292a1865baa7bcb91526d scripts/train_crossdata_transfer.py"@en,
        "sha256 26ab39500e8f9a7288f05973e73a4a52dce4a6080f1b97bea9e03cd006361ed1 scripts/eval_crossdata_transfer_supplement.py"@en,
        "sha256 78df57523e7f9e2795a03abfaf6bff987d9ef39ecc174a6f699679b73d51b0fb crossdata_transfer.json"@en,
        "sha256 b57302d8656dc7bed84d15fa65198611306b880a97f5a12564d8fd4a45912100 scripts/eval_crossdata_transfer.py"@en ;
    skos:scopeNote "Datasets with many closely related labels (for example 28 or 32) lose rank to those neighbours; this is an effect of granularity."@en,
        "In some target datasets the label word itself occurs in the positive texts (about 20% in GoEmotions, 7% in EmpatheticDialogues), which favours name-matched transfer; removing those rows changed the overall rates by less than 0.02."@en,
        "One model (roberta-base), one training setting (at most 8,000 training rows, no model selection on validation data), five seeds, English only."@en,
        "Rare labels had about 20 training positives or fewer after sampling (for example GoEmotions 'pride', DailyDialog 'fear'); for pairs with these as the source this study cannot tell whether the label fails to transfer or the training sample was too small (their verdicts remain NotSupported or Partial as pre-registered)."@en,
        "The evaluation rows are fixed; the seeds vary only the initialisation and data order of training, so agreement across seeds does not measure uncertainty across datasets or labels."@en,
        "The highest values are for pairs in which both datasets were labelled by the writer; all of these datasets consist of event descriptions, so labelling method and text type cannot be separated."@en,
        "The numbers are aggregate statistics computed from the datasets; no dataset text is included. The datasets themselves remain under their own licences."@en,
        "The verdict rule has no absolute floor: some pairs with a matched AUC below 0.6 are Partial. Compare matchedAuc with bestOtherAuc instead of relying on the verdict alone."@en,
        "To be read together with the re-run CrossDatasetTransfer2026b, which kept the positives of rare labels in the training sample (DailyDialog 'fear': 124 instead of 11-16; GoEmotions 'pride': 111 instead of 16-24). With DailyDialog 'fear' as the source, all 8 pairs were then Supported (name-matched label ranked first in at least 4 of 5 seeds); with GoEmotions 'pride' as the source, 2 of 3 pairs were, by a small margin. For these two sources the NotSupported and Partial verdicts of this study most likely reflect too few training positives; the design cannot separate this from the change of seeds."@en,
        "Transfer does not show that two labels denote the same concept, and a lack of transfer does not show that they differ: granularity, label frequency, text type and the number of training positives also change the result."@en,
        "Within rank three is easy to reach by chance when the source model has few labels (probability 0.60 with 5 labels); see sourceLabelCount."@en .

evd:CrossDatasetTransfer2026b a evd:EvidenceStudy ;
    rdfs:label "Cross-dataset transfer of name-matched labels, re-run with rare labels kept (2026-11b)"@en ;
    dcterms:date "2026-11-27"^^xsd:date ;
    dcterms:description "A re-run of CrossDatasetTransfer2026 with seeds 47-51, evaluation rows re-drawn with a new seed (identical for the three target datasets that have at most 5,000 rows; the number of evaluation rows is not recorded per pair), and a training sample that first takes up to 200 positives of every label and then fills up to 8,000 rows at random. The pre-registered measure is the matched AUC minus the best other AUC; the verdict rule is given at evd:preregisteredVerdict."@en ;
    dcterms:relation evd:CrossDatasetTransfer2026 ;
    dcterms:source "CombineEFOMoE issue #91 (pre-registered); mapping module 0.6.1 (the records of its 12 datasets are unchanged in 0.7.0)"@en,
        "sha256 020422159ecb66e90e5a54f9695a1ecf538296b1d0c459354858ec18dcaf971b scripts/export_transfer_evidence_csv.py"@en,
        "sha256 19a560217dbaa535e1451c07008b43a821e4c1a4728292a1865baa7bcb91526d scripts/train_crossdata_transfer.py"@en,
        "sha256 1d4a220a26228dee4db60e599a126a4c5220aaa5034f2a7efcfc20238ea746a0 scripts/eval_crossdata_transfer_v2.py"@en,
        "sha256 6f9951e442926f9484548ccd0a476df8c604c6af884f90ef61332db7e48372ac crossdata_transfer_v2.json"@en,
        "sha256 fc8dc8591e389600ee52cff3e36ae00d57e42de57e1ef7dc1535bf407d9c9737 scripts/train_crossdata_transfer_v2.py"@en ;
    skos:scopeNote "A re-run of CrossDatasetTransfer2026 on the same 10 datasets with the same model and mapping; it is not an independent replication. Six source datasets use the same training rows as the first study, three target datasets the same evaluation rows, and 17% of the pairs differ only in the seeds."@en,
        "For terms that are not basic emotions, the best other label shares an underlying basic emotion with the term in 62% of the seed-wise comparisons (for example guilt and shame, pride and joy); against unrelated labels the name-matched label is ahead on average."@en,
        "One model (roberta-base), one training setting, five seeds (47-51), English only."@en,
        "Rare labels enter the training sample with all their positives in every seed, and the label distribution of the sample differs from the natural one."@en,
        "Results depend strongly on the source dataset. For terms that are not basic emotions, the 18 pairs whose source is GoEmotions or GoodNewsEveryone taken together have the name-matched label behind the best other label on average (-0.031), while the other 28 pairs have it ahead (+0.045). For basic emotions the mean difference by source dataset ranges from -0.001 (GoEmotions) to +0.227 (BRIGHTER)."@en,
        "The numbers are aggregate statistics computed from the datasets; no dataset text is included. The datasets themselves remain under their own licences."@en,
        "The thresholds of the verdict rule (50 training positives, AUC 0.6, 4 of 5 seeds) were chosen by the authors. One source label has 53 training positives, just above the threshold."@en,
        "Transfer does not show that two labels denote the same concept, and a lack of transfer does not show that they differ."@en .

evd:CrossDatasetTransfer2026c a evd:EvidenceStudy ;
    rdfs:label "Cross-dataset transfer of name-matched labels, with 9 further datasets (2026-11c)"@en ;
    dcterms:date "2026-11-28"^^xsd:date ;
    dcterms:description "The setting of CrossDatasetTransfer2026b (roberta-base, seeds 47-51, at most 8,000 training rows with up to 200 positives of every label taken first) applied to 19 datasets: the 10 earlier ones, trained again with the same seeds, and 9 further ones. Evaluation rows were re-drawn with a new seed (at most 5,000 per dataset). The labels of the 9 further datasets were mapped by the unchanged rule of the mapping module (identical name or listed name variant); the experiment applied the rule directly, and mapping module 0.7.0 records the same 51 mappings. A pair is included when both labels map to the same Plutchik term, the target label has at least 20 positive and 20 negative rows, and the source or the target dataset is one of the 9 further datasets."@en ;
    dcterms:relation evd:CrossDatasetTransfer2026b ;
    dcterms:source "CombineEFOMoE issues #100 (pre-registered) and #101 (criteria fixed before computing, after seeing #100); mapping module 0.7.0"@en,
        "sha256 199b46ed14832b2f6d2918f07fa424980654bc9fd661677057e49a2d39d3e187 scripts/eval_crossdata_transfer_v4.py"@en,
        "sha256 4a5f769be43a1f2512039e12a7338a4db3fcc20fb100fe7b481fc9a44a839c02 scripts/export_transfer_evidence_csv_v4.py"@en,
        "sha256 5e79e9b85b81ff3fbf7298b60da8262220334444c1bc35c2d097688635f2bd7c scripts/prepare_crossdata_extra.py"@en,
        "sha256 96d8d960eeba1877d0e271586c58a7d79278eeb06ae0d37cb0dbcde0fd305f26 crossdata_basic_rivals.json"@en,
        "sha256 c5b32a8cd26845b96d321d77e6ef46d066d47bfad278004d1825d6b714bf03dc scripts/train_crossdata_transfer_v4.py"@en,
        "sha256 dd68796237576e1910a39f8f89f8c8a6a2af6de63605b0be15ce69d232fccff5 scripts/eval_crossdata_basic_rivals.py"@en,
        "sha256 e52c6d496d5bf593b0dbc25604f9c64b05dcb619a7a26a25d9ad7178630a113a crossdata_transfer_v4.json"@en,
        "sha256 fc8dc8591e389600ee52cff3e36ae00d57e42de57e1ef7dc1535bf407d9c9737 scripts/train_crossdata_transfer_v2.py"@en ;
    skos:scopeNote "Disgust and anger are each other's most frequent best other basic-emotion label (Disgust: anger in 127 of 132 pairs; Anger: disgust in 163 pairs), and the name-matched label is ahead in about three quarters of those pairs in both directions. From the two source datasets with many labels, Disgust is the one basic emotion whose name-matched label is barely ahead of the other basic-emotion labels (+0.011, ahead in 7 of 12 pairs; Anger: +0.055, 15 of 16)."@en,
        "For terms that are not basic emotions the mean difference is positive in this study (+0.047), but only for pairs whose source is a new dataset (+0.079); from an earlier source dataset to a new target dataset it is +0.001. It is not treated as an established result."@en,
        "Known defects of the prepared data, left as they were because the models had been trained on them: in ISEAR, 163 texts (2.2%) are cut at a separator character and about 40 non-responses remain; CARER contains about 170 ISEAR texts; in TEC, 14 tweets occur with different labels; in MELD, utterances with conflicting labels were removed, which removed 18% of 'surprise'."@en,
        "One model (roberta-base), one training setting, five seeds (47-51), English only. The 19 datasets are not a random sample of datasets."@en,
        "Only pairs in which the source or the target dataset is one of the 9 datasets added in this study are recorded (1,029 pairs). Pairs between the 10 earlier datasets were also computed, with models trained again in the setting and with the seeds of CrossDatasetTransfer2026b (the weights of that study were not kept), and are not recorded again."@en,
        "The best other basic-emotion AUC uses a smaller set of rivals than the best other AUC. For 597 of the 954 pairs that record it, it equals the best other AUC. Where it is lower, the number of rivals matters: for the two source datasets with many labels (GoEmotions, EmpatheticDialogues; the only ones for which this was checked), rivals drawn at random in the same number give nearly the same value (the remaining difference is +0.009 and +0.011, the interval of the second excluding zero). What it does show is that the name-matched label is not interchangeable with the labels of other basic emotions."@en,
        "The difference between the matched AUC and the best other AUC depends on the label set of the source dataset. With 16 or more source labels (GoEmotions, EmpatheticDialogues) it is close to zero even for basic emotions (+0.009 and -0.008 in two subsets; no interval was computed for these); with 7 or fewer it is large. Pairs whose source is one of the new datasets (5 to 12 labels) are therefore favoured, and the stricter reading uses only pairs from an earlier source dataset to a new target dataset."@en,
        "The native AUC is missing for 14 pairs whose target is the Real World Worry label 'disgust', which has 2 positive rows in its test split."@en,
        "The numbers are aggregate statistics computed from the datasets; no dataset text is included. The datasets themselves remain under their own terms."@en,
        "The per-pair verdict was not pre-registered for this study. It is the rule pre-registered for CrossDatasetTransfer2026b, applied unchanged. The pre-registered criteria of this study were aggregate ones (mean difference between the matched AUC and the best other AUC, with intervals from resampling datasets)."@en,
        "Three of the new datasets are distantly supervised (CBET, CARER, TEC), and most labels of StockEmotions were produced by a model and then checked by people. In a spot check of 15 texts per label, some labels that are not basic emotions did not match their name well (CBET 'guilt' and 'love', CARER 'love', StockEmotions 'optimism' and 'anxiety')."@en,
        "Transfer does not show that two labels denote the same concept, and a lack of transfer does not show that they differ."@en .

evd:Supported a evd:Verdict ;
    rdfs:label "Supported"@en .

evd:TransferEvidence a owl:Class ;
    rdfs:label "Transfer evidence"@en,
        "転移の証拠"@ja ;
    skos:definition "For two mapping records that map labels of two different datasets to the same Plutchik term: how well a classifier trained on the source dataset's label separates the target dataset's label. It is evidence about one experimental setting, not a judgement that the mapping is right or wrong."@en .

