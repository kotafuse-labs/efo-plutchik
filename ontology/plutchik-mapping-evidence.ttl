evd:targetMapping a owl:ObjectProperty ;
    rdfs:label "target mapping"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range map:ConceptMapping ;
    skos:definition "The mapping record of the label the classifier was evaluated against."@en .

evd:targetPositives a owl:DatatypeProperty ;
    rdfs:label "target positives"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of positive rows of the target label among the evaluation rows."@en .

evd:targetRows a owl:DatatypeProperty ;
    rdfs:label "target rows"@en ;
    rdfs:domain evd:TransferEvidence ;
    rdfs:range xsd:integer ;
    skos:definition "Number of evaluation rows."@en .

evd:EvidenceStudy a owl:Class ;
    rdfs:label "Evidence study"@en,
        "証拠の調査"@ja ;
    skos:definition "An experiment that produced transfer evidence, with its setting and known limitations."@en .

evd:Verdict a owl:Class ;
    rdfs:label "Pre-registered verdict"@en,
        "事前登録の判定"@ja ;
    skos:definition "The per-pair verdict defined in the study's pre-registration."@en .

evd:NotSupported a evd:Verdict ;
    rdfs:label "NotSupported"@en .

evd:Partial a evd:Verdict ;
    rdfs:label "Partial"@en .

evd:Supported a evd:Verdict ;
    rdfs:label "Supported"@en .

evd:CrossDatasetTransfer2026 a evd:EvidenceStudy ;
    rdfs:label "Cross-dataset transfer of name-matched labels (2026-11)"@en ;
    dcterms:date "2026-11-27"^^xsd:date ;
    dcterms:description "For each of 10 English emotion datasets a multi-label roberta-base classifier was trained on the dataset's own labels (learning rate 2e-5, at most 8,000 training rows, seeds 42-46) and applied to up to 5,000 fixed rows of every other dataset. A pair is included when both labels map to the same Plutchik term and the target label has at least 20 positive and 20 negative rows."@en ;
    dcterms:source "CombineEFOMoE issue #88 (pre-registered); mapping module 0.6.1"@en,
        "sha256 04bbf33b5e651cc8ad34589ba1766bed799ac1947018131ffb24c08aaa1742fd crossdata_transfer_supplement.json"@en,
        "sha256 19a560217dbaa535e1451c07008b43a821e4c1a4728292a1865baa7bcb91526d scripts/train_crossdata_transfer.py"@en,
        "sha256 26ab39500e8f9a7288f05973e73a4a52dce4a6080f1b97bea9e03cd006361ed1 scripts/eval_crossdata_transfer_supplement.py"@en,
        "sha256 78df57523e7f9e2795a03abfaf6bff987d9ef39ecc174a6f699679b73d51b0fb crossdata_transfer.json"@en,
        "sha256 b57302d8656dc7bed84d15fa65198611306b880a97f5a12564d8fd4a45912100 scripts/eval_crossdata_transfer.py"@en,
        "sha256 b6871e16b5415e9465bd4dcdaac093d76a0b67cec7f37373c4c6f705b4e6258f scripts/export_transfer_evidence_csv.py"@en ;
    skos:scopeNote "Datasets with many closely related labels (for example 28 or 32) lose rank to those neighbours; this is an effect of granularity."@en,
        "In some target datasets the label word itself occurs in the positive texts (about 20% in GoEmotions, 7% in EmpatheticDialogues), which favours name-matched transfer; removing those rows changed the overall rates by less than 0.02."@en,
        "One model (roberta-base), one training setting (at most 8,000 training rows, no model selection on validation data), five seeds, English only."@en,
        "Rare labels had about 20 training positives or fewer after sampling (for example GoEmotions 'pride', DailyDialog 'fear'); pairs with these as the source are inconclusive."@en,
        "The evaluation rows are fixed; the seeds vary only the initialisation and data order of training, so agreement across seeds does not measure uncertainty across datasets or labels."@en,
        "The highest values are for pairs in which both datasets were labelled by the writer; all of these datasets consist of event descriptions, so labelling method and text type cannot be separated."@en,
        "The numbers are aggregate statistics computed from the datasets; no dataset text is included. The datasets themselves remain under their own licences."@en,
        "The verdict rule has no absolute floor: some pairs with a matched AUC below 0.6 are Partial. Compare matchedAuc with bestOtherAuc instead of relying on the verdict alone."@en,
        "Transfer does not show that two labels denote the same concept, and a lack of transfer does not show that they differ: granularity, label frequency, text type and the number of training positives also change the result."@en,
        "Within rank three is easy to reach by chance when the source model has few labels (probability 0.60 with 5 labels); see sourceLabelCount."@en .

evd:TransferEvidence a owl:Class ;
    rdfs:label "Transfer evidence"@en,
        "転移の証拠"@ja ;
    skos:definition "For two mapping records that map labels of two different datasets to the same Plutchik term: how well a classifier trained on the source dataset's label separates the target dataset's label. It is evidence about one experimental setting, not a judgement that the mapping is right or wrong."@en .

