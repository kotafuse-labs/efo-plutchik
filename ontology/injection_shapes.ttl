@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix plu:  <https://w3id.org/efo-plutchik#> .
@prefix emo:  <http://www.ontologydesignpatterns.org/ont/emotions/EmoCore.owl#> .
@prefix inj:  <https://w3id.org/efo-plutchik/injection#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# 注入知識 provenance KG (src/provenance/to_rdf.py 出力) の SHACL 制約。
# 本研究の核「verifiable provenance of knowledge influence」(RELATED_WORK_DIFF) の検証側。
# src/provenance/validate.py:validate_injection_kg が pySHACL で適用する。

# 各注入予測 (inj:derivedByMethod を持つ occ) は感情・モデル・influence を必須とする。
inj:InjectionPredictionShape a sh:NodeShape ;
    sh:targetSubjectsOf inj:derivedByMethod ;
    sh:property [
        sh:path plu:isManifestationOf ;
        sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "An injected-knowledge prediction must manifest at least one emotion."@en ;
    ] ;
    sh:property [
        sh:path plu:sourceModel ;
        sh:minCount 1 ;
        sh:message "A prediction must record the source model (provenance attribution)."@en ;
    ] ;
    sh:property [
        sh:path inj:influencedBy ;
        sh:minCount 1 ;
        sh:message "A prediction must record at least one knowledge influence."@en ;
    ] .

# 各 influence は knowledge ノードと数値スコアをちょうど 1 つずつ持つ。
inj:InfluenceShape a sh:NodeShape ;
    sh:targetClass inj:Influence ;
    sh:property [
        sh:path inj:knowledgeNode ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "An influence must point to exactly one knowledge node."@en ;
    ] ;
    sh:property [
        sh:path inj:attributionScore ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:float ;
        sh:message "An influence must carry exactly one float attribution score."@en ;
    ] ;
    # 各寄与は「どの attribution 手法が生成したか」を Activity 経由で必ず辿れる (手法 traceability)。
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class inj:AttributionActivity ;
        sh:message "An influence must be generated by exactly one attribution activity (traceable to a method)."@en ;
    ] .

# 各 attribution activity は適用手法 (inj:AttributionMethod) と使用した知識グラフ (prov:Entity) を必須とする。
# = どの寄与スコアも「どの手法で・どのグラフから」得られたかが KG 内で機械的に追跡できる。
inj:AttributionActivityShape a sh:NodeShape ;
    sh:targetClass inj:AttributionActivity ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class inj:AttributionMethod ;
        sh:message "An attribution activity must be associated with a named attribution method."@en ;
    ] ;
    sh:property [
        sh:path prov:used ;
        sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "An attribution activity must record the knowledge graph it used."@en ;
    ] .
