# EFO-Plutchik v0.5.0 — データセットラベル写像の provenance competency questions (CQ-M1〜M5)
# plutchik-mappings.ttl + efo-plutchik.ttl に対して、validate.run_mapping_cqs が見出しごとに切り出し、共通 PREFIX を前置して実行する。
# 共通 PREFIX (付与される): plu: / map: / skos: / dcterms: / rdfs:
# 注意: コメントに見出しの記号列を書かないこと（split が誤爆する）。

### CQ-M1: 各データセットラベルが、どの方式で・どの感情に・どの種類の対応で・どの根拠で写されたかを追跡できるか
SELECT ?scheme ?dataset ?label ?kind ?target ?match ?basis WHERE {
    ?r map:inScheme ?scheme ; map:dataset ?dataset ; map:sourceLabel ?label ; map:basis ?basis ; a ?kind .
    FILTER(?kind IN (map:ComponentMapping, map:ConceptMapping, map:UnmappedLabel))
    OPTIONAL { ?r map:mapsTo ?target }
    OPTIONAL { ?r map:matchType ?match }
}
ORDER BY ?scheme ?dataset ?label ?target

### CQ-M2: 網羅性 — ある方式にだけ記録があり、別の方式で記録が欠けているラベル (期待: 空)
SELECT ?scheme ?dataset ?label WHERE {
    ?scheme a map:MappingScheme .
    { SELECT DISTINCT ?dataset ?label WHERE { ?x map:dataset ?dataset ; map:sourceLabel ?label } }
    FILTER NOT EXISTS { ?r map:inScheme ?scheme ; map:dataset ?dataset ; map:sourceLabel ?label }
}

### CQ-M3: 根拠の完全性 — 根拠 (map:basis) のない記録と、文献 (dcterms:bibliographicCitation) のない方式 (期待: 空)
SELECT ?x ?missing WHERE {
    { ?x map:inScheme ?s . FILTER NOT EXISTS { ?x map:basis ?b } BIND("basis" AS ?missing) }
    UNION
    { ?x a map:MappingScheme . FILTER NOT EXISTS { ?x dcterms:bibliographicCitation ?c } BIND("citation" AS ?missing) }
}

### CQ-M4: 方式・データセット・記録の種類・対応の種類ごとの件数
SELECT ?scheme ?dataset ?kind ?match (COUNT(DISTINCT ?r) AS ?n) WHERE {
    ?r map:inScheme ?scheme ; map:dataset ?dataset ; a ?kind .
    FILTER(?kind IN (map:ComponentMapping, map:ConceptMapping, map:UnmappedLabel))
    OPTIONAL { ?r map:matchType ?match }
}
GROUP BY ?scheme ?dataset ?kind ?match
ORDER BY ?scheme ?dataset ?kind ?match

### CQ-M5: 2 方式で基本感情 8 への落とし方が食い違うラベルと、どちらにだけある基本感情か (強度の変種は intensityOf、dyad は成分に落とす)
SELECT DISTINCT ?dataset ?label ?basic ?onlyIn WHERE {
    ?lc map:inScheme map:LimCheong2024 ; map:dataset ?dataset ; map:sourceLabel ?label .
    ?pn map:inScheme map:Plutchik2001Names ; map:dataset ?dataset ; map:sourceLabel ?label .
    {
        ?pn map:mapsTo/(plu:intensityOf|plu:hasComponentEmotion)? ?basic .
        ?basic a plu:BasicEmotion .
        FILTER NOT EXISTS { ?lc map:mapsTo ?basic }
        BIND("Plutchik2001Names" AS ?onlyIn)
    }
    UNION
    {
        ?lc map:mapsTo ?basic .
        FILTER NOT EXISTS { ?pn map:mapsTo/(plu:intensityOf|plu:hasComponentEmotion)? ?basic }
        BIND("LimCheong2024" AS ?onlyIn)
    }
}
ORDER BY ?dataset ?label ?basic
