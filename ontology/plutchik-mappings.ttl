# EFO-Plutchik のデータセットラベル写像（写像のモジュール 0.6.1。コアのオントロジーは 0.5.0 のまま）。ontology/build_mappings.py が生成する（直接編集しない）。
# 方式 2 つ: map:LimCheong2024（再現用、成分写像。2 データセット）/ map:Plutchik2001Names（名前に基づく、強度・dyad まで。12 データセット）。
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix map: <https://w3id.org/efo-plutchik/mapping#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix plu: <https://w3id.org/efo-plutchik#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/efo-plutchik/mapping> a owl:Ontology ;
    rdfs:label "EFO-Plutchik dataset label mappings"@en,
        "EFO-Plutchik のデータセットラベル写像"@ja ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "Generated by ontology/build_mappings.py; edit the script, not this file."@en,
        "Mapping module 0.6.1 (12 datasets, labelling methods, name-variant rules). It imports the core ontology 0.5.0, which is unchanged."@en ;
    owl:imports <https://w3id.org/efo-plutchik/0.5.0> ;
    owl:versionInfo "0.6.1" .

map:basis a owl:DatatypeProperty ;
    rdfs:label "basis"@en,
        "根拠"@ja ;
    rdfs:range xsd:string ;
    skos:definition "Why the label is mapped (or not mapped) as stated."@en,
        "そのように写す（または写さない）根拠。"@ja .

map:coversDataset a owl:ObjectProperty ;
    rdfs:label "covers dataset"@en,
        "対象のデータセット"@ja ;
    rdfs:range skos:ConceptScheme ;
    skos:definition "A dataset label scheme that a mapping scheme covers; every label of a covered dataset has one record in the scheme."@en,
        "写像方式が対象とするデータセットのラベル体系。対象のデータセットのラベルは、その方式に記録を 1 つずつ持つ。"@ja .

map:dataset a owl:DatatypeProperty ;
    rdfs:label "dataset"@en,
        "データセット"@ja ;
    rdfs:range xsd:string ;
    skos:definition "The dataset the label belongs to."@en,
        "ラベルが属するデータセット。"@ja .

map:datasetKey a owl:DatatypeProperty ;
    rdfs:label "dataset key"@en,
        "データセットのキー"@ja ;
    rdfs:range xsd:string ;
    skos:definition "The short key of the dataset; mapping records of its labels carry the same value in map:dataset."@en,
        "データセットの短いキー。そのラベルの写像の記録は、map:dataset に同じ値を持つ。"@ja .

map:inScheme a owl:ObjectProperty ;
    rdfs:label "in scheme"@en,
        "写像方式"@ja ;
    rdfs:range map:MappingScheme ;
    skos:definition "The mapping scheme a mapping record belongs to."@en,
        "写像の記録が属する写像方式。"@ja .

map:intensityScale a owl:DatatypeProperty ;
    rdfs:label "intensity scale"@en,
        "強度の尺度"@ja ;
    rdfs:range xsd:string ;
    skos:definition "The scale on which the dataset records emotion intensity, if it does."@en,
        "データセットが感情の強度を記録する場合の尺度。"@ja .

map:label a owl:ObjectProperty ;
    rdfs:label "label"@en,
        "ラベル"@ja ;
    rdfs:range skos:Concept ;
    skos:definition "The dataset label concept a mapping record is about."@en,
        "写像の記録が対象とするデータセットのラベル概念。"@ja .

map:labelCardinality a owl:DatatypeProperty ;
    rdfs:label "label cardinality"@en,
        "ラベルの数"@ja ;
    rdfs:range xsd:string ;
    skos:definition "Whether an instance carries one label or several."@en,
        "1 つの事例が持つラベルが 1 つか複数か。"@ja .

map:labellingMethod a owl:ObjectProperty ;
    rdfs:label "labelling method"@en,
        "ラベルの付け方"@ja ;
    rdfs:range map:LabellingMethod ;
    skos:definition "How the instances of the dataset received their labels."@en,
        "そのデータセットの事例にラベルが付いた方法。"@ja .

map:labelsCheckedIn a owl:DatatypeProperty ;
    rdfs:label "labels checked in"@en,
        "ラベルの確認元"@ja ;
    rdfs:range xsd:string ;
    skos:definition "Where the label list was checked, and what was not checked."@en,
        "ラベルの一覧を確認した場所と、確認していない点。"@ja .

map:lc_goemotions_admiration a map:ComponentMapping ;
    map:basis "Lim & Cheong (2024): admiration -> Trust." ;
    map:dataset "goemotions" ;
    map:inScheme map:LimCheong2024 ;
    map:label <https://w3id.org/efo-plutchik/mapping#goemotions/admiration> ;
    map:mapsTo plu:Trust ;
    map:sourceLabel "admiration" .

map:lc_goemotions_amusement a map:UnmappedLabel ;
    map:basis "Dropped by Lim & Cheong (2024)." ;
    map:dataset "goemotions" ;
    map:inScheme map:LimCheong2024 ;
    map:label <https://w3id.org/efo-plutchik/mapping#goemotions/amusement> ;
    map:sourceLabel "amusement" .

