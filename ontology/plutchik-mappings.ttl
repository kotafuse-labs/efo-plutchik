map:mapsTo a owl:ObjectProperty ;
    rdfs:label "maps to"@en,
        "写す先"@ja ;
    rdfs:range plu:PlutchikEmotion ;
    skos:definition "The Plutchik emotion a label mapping targets."@en,
        "ラベル写像の写す先の Plutchik の感情。"@ja .

map:matchType a owl:ObjectProperty ;
    rdfs:label "match type"@en,
        "対応の種類"@ja ;
    rdfs:range rdf:Property ;
    skos:definition "The SKOS mapping property (closeMatch / broadMatch) that holds from the label concept to the target."@en,
        "ラベル概念から写す先へ成り立つ SKOS の対応関係（closeMatch / broadMatch）。"@ja .

map:nameVariantOf a owl:DatatypeProperty ;
    rdfs:label "name variant of"@en,
        "語形の元の語"@ja ;
    rdfs:range xsd:string ;
    skos:definition "The Plutchik (2001) term of which the dataset label is a listed adjective or participle form."@en,
        "データセットのラベルが、その形容詞・分詞の形として表に載っている Plutchik (2001) の語。"@ja .

map:pn_brighter_eng_anger a map:ConceptMapping ;
    map:basis "Label name identical to the Plutchik (2001) term 'anger'." ;
    map:dataset "brighter_eng" ;
    map:inScheme map:Plutchik2001Names ;
    map:label <https://w3id.org/efo-plutchik/mapping#brighter_eng/anger> ;
    map:mapsTo plu:Anger ;
    map:matchType skos:closeMatch ;
    map:sourceLabel "anger" .

