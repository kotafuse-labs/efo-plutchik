map:mapsTo a owl:ObjectProperty ;
    rdfs:label "maps to"@en,
        "写す先"@ja ;
    rdfs:range plu:PlutchikEmotion ;
    skos:definition "The Plutchik emotion a label mapping targets."@en,
        "ラベル写像の写す先の Plutchik の感情。"@ja .

map:matchType a owl:ObjectProperty ;
    rdfs:label "match type"@en,
        "対応の種類"@ja ;
    rdfs:range rdf:Property ;
    skos:definition "The SKOS mapping property (closeMatch / broadMatch) that holds from the label concept to the target."@en,
        "ラベル概念から写す先へ成り立つ SKOS の対応関係（closeMatch / broadMatch）。"@ja .

map:pn_goemotions_admiration a map:ConceptMapping ;
    map:basis "Label name identical to the Plutchik (2001) term 'admiration'. Demszky et al. (2020) group it under Ekman 'joy', which is not among its Plutchik components; the name match takes precedence." ;
    map:dataset "goemotions" ;
    map:inScheme map:Plutchik2001Names ;
    map:label <https://w3id.org/efo-plutchik/mapping#goemotions/admiration> ;
    map:mapsTo plu:Admiration ;
    map:matchType skos:closeMatch ;
    map:sourceLabel "admiration" .

map:pn_goemotions_amusement a map:ConceptMapping ;
    map:basis "No Plutchik (2001) term of this name; Demszky et al. (2020) group it under Ekman 'joy', which corresponds to the Plutchik basic emotion Joy." ;
    map:dataset "goemotions" ;
    map:inScheme map:Plutchik2001Names ;
    map:label <https://w3id.org/efo-plutchik/mapping#goemotions/amusement> ;
    map:mapsTo plu:Joy ;
    map:matchType skos:broadMatch ;
    map:sourceLabel "amusement" .

