map:MappingScheme a owl:Class ;
    rdfs:label "Mapping Scheme"@en,
        "写像方式"@ja ;
    skos:definition "A documented scheme for mapping dataset labels to Plutchik emotions."@en,
        "データセットのラベルを Plutchik の感情に写す、出典つきの方式。"@ja .

map:UnmappedLabel a owl:Class ;
    rdfs:label "Unmapped Label"@en,
        "写さないラベル"@ja ;
    skos:definition "A record that a dataset label is not mapped under a scheme, with the reason."@en,
        "ある写像方式でデータセットのラベルを写さないことと、その理由の記録。"@ja .

map:semeval2018_labels a skos:ConceptScheme ;
    rdfs:label "SemEval-2018 Task 1 E-c"@en,
        "SemEval-2018 Task 1 E-c のラベル"@ja .

map:goemotions_labels a skos:ConceptScheme ;
    rdfs:label "GoEmotions"@en,
        "GoEmotions のラベル"@ja .

map:ComponentMapping a owl:Class ;
    rdfs:label "Component Mapping"@en,
        "成分写像"@ja ;
    rdfs:subClassOf map:LabelMapping ;
    skos:definition "A label mapping that maps a label to one or two Plutchik basic emotions as its components."@en,
        "ラベルを 1〜2 個の基本感情の成分に写すラベル写像。"@ja .

map:ConceptMapping a owl:Class ;
    rdfs:label "Concept Mapping"@en,
        "概念写像"@ja ;
    rdfs:subClassOf map:LabelMapping ;
    skos:definition "A label mapping that maps a label to exactly one Plutchik emotion with a SKOS match type."@en,
        "ラベルを SKOS の対応の種類つきで Plutchik の感情 1 つに写すラベル写像。"@ja .

map:LimCheong2024 a owl:NamedIndividual,
        map:MappingScheme ;
    rdfs:label "Lim & Cheong (2024) mapping"@en,
        "Lim & Cheong (2024) の写像"@ja ;
    dcterms:bibliographicCitation "Lim, D. and Cheong, Y.-G. (2024). Integrating Plutchik's Theory with Mixture of Experts for Enhancing Emotion Classification. EMNLP 2024, 857-867; Table 1 (SemEval-2018) and Table 2 (GoEmotions)." ;
    skos:definition "The component mapping used by Lim & Cheong (2024); kept for reproducing CombineEFOMoE experiments."@en,
        "Lim & Cheong (2024) が使った成分写像。CombineEFOMoE の実験を再現するために残す。"@ja .

map:Plutchik2001Names a owl:NamedIndividual,
        map:MappingScheme ;
    rdfs:label "Plutchik (2001) names mapping"@en,
        "Plutchik (2001) の名前に基づく写像"@ja ;
    dcterms:bibliographicCitation "Plutchik, R. (2001). The Nature of Emotions. American Scientist 89(4), 344-350. Demszky, D. et al. (2020). GoEmotions: A Dataset of Fine-Grained Emotions. ACL 2020, 4040-4054; Ekman grouping from google-research/goemotions/data/ekman_mapping.json (retrieved 2026-11-14)." ;
    skos:definition "Maps each label to one Plutchik emotion (basic, intensity variant or dyad) by name, falling back to the Demszky et al. (2020) Ekman grouping; unmapped labels carry a reason."@en,
        "各ラベルを名前で Plutchik の感情（基本感情・強度の変種・dyad）1 つに写し、当たらなければ Demszky et al. (2020) の Ekman 対応を使う。写さないラベルには理由を付ける。"@ja .

