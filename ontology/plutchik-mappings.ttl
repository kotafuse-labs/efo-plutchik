map:sourceLabel a owl:DatatypeProperty ;
    rdfs:label "source label"@en,
        "元のラベル"@ja ;
    rdfs:range xsd:string ;
    skos:definition "The label as written in the dataset."@en,
        "データセットに書かれたとおりのラベル。"@ja .

map:variantForm a owl:DatatypeProperty ;
    rdfs:label "variant form"@en,
        "語形"@ja ;
    rdfs:range xsd:string ;
    skos:definition "The adjective or participle form listed by a name-variant rule."@en,
        "語形の規則が挙げる形容詞・分詞の形。"@ja .

map:variantOfTerm a owl:ObjectProperty ;
    rdfs:label "variant of term"@en,
        "語形の元の感情"@ja ;
    rdfs:range plu:PlutchikEmotion ;
    skos:definition "The Plutchik emotion whose name a name-variant rule relates the form to."@en,
        "語形の規則が、その形を名前に結びつける Plutchik の感情。"@ja .

map:variant_angry a map:NameVariantRule ;
    map:variantForm "angry" ;
    map:variantOfTerm plu:Anger .

map:variant_annoyed a map:NameVariantRule ;
    map:variantForm "annoyed" ;
    map:variantOfTerm plu:Annoyance .

map:variant_anticipating a map:NameVariantRule ;
    map:variantForm "anticipating" ;
    map:variantOfTerm plu:Anticipation .

map:variant_anxious a map:NameVariantRule ;
    map:variantForm "anxious" ;
    map:variantOfTerm plu:Anxiety .

map:variant_apprehensive a map:NameVariantRule ;
    map:variantForm "apprehensive" ;
    map:variantOfTerm plu:Apprehension .

map:variant_ashamed a map:NameVariantRule ;
    map:variantForm "ashamed" ;
    map:variantOfTerm plu:Shame .

map:variant_disgusted a map:NameVariantRule ;
    map:variantForm "disgusted" ;
    map:variantOfTerm plu:Disgust .

map:variant_guilty a map:NameVariantRule ;
    map:variantForm "guilty" ;
    map:variantOfTerm plu:Guilt .

map:variant_hopeful a map:NameVariantRule ;
    map:variantForm "hopeful" ;
    map:variantOfTerm plu:Hope .

map:variant_joyful a map:NameVariantRule ;
    map:variantForm "joyful" ;
    map:variantOfTerm plu:Joy .

map:variant_proud a map:NameVariantRule ;
    map:variantForm "proud" ;
    map:variantOfTerm plu:Pride .

map:variant_sad a map:NameVariantRule ;
    map:variantForm "sad" ;
    map:variantOfTerm plu:Sadness .

map:variant_sentimental a map:NameVariantRule ;
