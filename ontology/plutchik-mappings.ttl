map:MappingScheme a owl:Class ;
    rdfs:label "Mapping Scheme"@en,
        "写像方式"@ja ;
    skos:definition "A documented scheme for mapping dataset labels to Plutchik emotions."@en,
        "データセットのラベルを Plutchik の感情に写す、出典つきの方式。"@ja .

map:WriterChosen a owl:NamedIndividual,
        map:LabellingMethod ;
    rdfs:label "writer-chosen"@en,
        "書き手の選択"@ja ;
    skos:definition "Labels given to or chosen by the writer, who then wrote the text for that label."@en,
        "書き手に与えられた、または書き手が選んだラベル。本文はそのラベルに合わせて書かれた。"@ja .

map:LabellingMethod a owl:Class ;
    rdfs:label "Labelling Method"@en,
        "ラベルの付け方"@ja ;
    skos:definition "How the instances of a dataset received their emotion labels."@en,
        "データセットの事例に感情のラベルが付いた方法。"@ja .

map:semeval2018_eioc_labels a skos:ConceptScheme ;
    rdfs:label "SemEval-2018 Task 1 EI-oc"@en,
        "SemEval-2018 Task 1 EI-oc のラベル"@ja ;
    dcterms:bibliographicCitation "Mohammad, S. M., Bravo-Marquez, F., Salameh, M. and Kiritchenko, S. (2018). SemEval-2018 Task 1: Affect in Tweets. SemEval 2018." ;
    dcterms:source <https://competitions.codalab.org/competitions/17751> ;
    map:datasetKey "semeval2018_eioc" ;
    map:intensityScale "0-3 ordinal classes cut from best-worst-scaling scores" ;
    map:labelCardinality "single (one emotion per file)" ;
    map:labellingMethod map:ScoreThresholded ;
    map:labelsCheckedIn "Paper, Sections 2 and 3.4.3; class strings in the data files. The intensity classes are not mapped to Plutchik intensity variants: a low class is a band of scores, not the label 'annoyance'." .

map:brighter_eng_labels a skos:ConceptScheme ;
    rdfs:label "BRIGHTER (English) / SemEval-2025 Task 11"@en,
        "BRIGHTER（英語）/ SemEval-2025 Task 11 のラベル"@ja ;
    dcterms:bibliographicCitation "Muhammad, S. H. et al. (2025). BRIGHTER: BRIdging the Gap in Human-Annotated Textual Emotion Recognition Datasets for 28 Languages. arXiv:2502.11926." ;
    dcterms:source <https://huggingface.co/datasets/brighter-dataset/BRIGHTER-emotion-categories> ;
    map:datasetKey "brighter_eng" ;
    map:intensityScale "0-3 per emotion (Track B)" ;
    map:labelCardinality "multi" ;
    map:labellingMethod map:ReaderAnnotated ;
    map:labelsCheckedIn "Paper, Section 2 (the English data do not include disgust; intensity 0-3)." .

map:ReaderAnnotated a owl:NamedIndividual,
        map:LabellingMethod ;
    rdfs:label "reader-annotated"@en,
        "読み手の注釈"@ja ;
    skos:definition "Labels assigned by readers of the text (crowd workers, students or experts)."@en,
        "本文の読み手（クラウドワーカー・学生・専門家）が付けたラベル。"@ja .

map:dailydialog_labels a skos:ConceptScheme ;
    rdfs:label "DailyDialog"@en,
        "DailyDialog のラベル"@ja ;
    dcterms:bibliographicCitation "Li, Y., Su, H., Shen, X., Li, W., Cao, Z. and Niu, S. (2017). DailyDialog: A Manually Labelled Multi-turn Dialogue Dataset. IJCNLP 2017, 986-995." ;
    dcterms:source <http://yanran.li/dailydialog> ;
    map:datasetKey "dailydialog" ;
    map:labelCardinality "single" ;
    map:labellingMethod map:ReaderAnnotated ;
    map:labelsCheckedIn "Paper, Section 3 (six emotions and one additional category for other emotions). The additional category is written 'no emotion' here, the name commonly used for class 0 of the released data; that name was not checked in the data files." .

map:enisear_labels a skos:ConceptScheme ;
    rdfs:label "enISEAR"@en,
        "enISEAR のラベル"@ja ;
    dcterms:bibliographicCitation "Troiano, E., Pado, S. and Klinger, R. (2019). Crowdsourcing and Validating Event-focused Emotion Corpora for German and English. ACL 2019, 4005-4011." ;
    dcterms:source <https://www.romanklinger.de/data-sets/deISEARenISEAR.zip> ;
    map:datasetKey "enisear" ;
    map:intensityScale "writer self-rating, 4 levels" ;
    map:labelCardinality "single" ;
    map:labellingMethod map:WriterChosen ;
    map:labelsCheckedIn "Paper, Sections 1 and 3; readme and column header of the data (the values of the label column were not checked)." .

map:ssec_labels a skos:ConceptScheme ;
    rdfs:label "SSEC"@en,
        "SSEC のラベル"@ja ;
    dcterms:bibliographicCitation "Schuff, H., Barnes, J., Mohme, J., Pado, S. and Klinger, R. (2017). Annotation, Modelling and Analysis of Fine-Grained Emotions on a Stance and Sentiment Detection Corpus. WASSA 2017." ;
    dcterms:source <https://www.romanklinger.de/ssec/> ;
    map:datasetKey "ssec" ;
    map:labelCardinality "multi" ;
    map:labellingMethod map:ReaderAnnotated ;
    map:labelsCheckedIn "Paper, Section 1 (the eight Plutchik emotions; multi-label). The values in the data files were not checked." .

map:xed_labels a skos:ConceptScheme ;
    rdfs:label "XED (English)"@en,
        "XED（英語）のラベル"@ja ;
    dcterms:bibliographicCitation "Oehman, E., Pamies, M., Kajava, K. and Tiedemann, J. (2020). XED: A Multilingual Dataset for Sentiment Analysis and Emotion Detection. COLING 2020." ;
    dcterms:source <https://github.com/Helsinki-NLP/XED> ;
    map:datasetKey "xed" ;
    map:labelCardinality "multi" ;
    map:labellingMethod map:ReaderAnnotated ;
    map:labelsCheckedIn "Paper; repository README (label numbers 1-8, neutral 0); dataset card." .

map:semeval2018_labels a skos:ConceptScheme ;
    rdfs:label "SemEval-2018 Task 1 E-c"@en,
        "SemEval-2018 Task 1 E-c のラベル"@ja ;
    dcterms:bibliographicCitation "Mohammad, S. M., Bravo-Marquez, F., Salameh, M. and Kiritchenko, S. (2018). SemEval-2018 Task 1: Affect in Tweets. SemEval 2018." ;
    dcterms:source <https://competitions.codalab.org/competitions/17751> ;
    map:datasetKey "semeval2018" ;
    map:labelCardinality "multi" ;
    map:labellingMethod map:ReaderAnnotated ;
    map:labelsCheckedIn "Task paper (11 emotions; crowdsourced annotation, seven annotators per tweet requested). Label list unchanged from release 0.5.0." .

map:crowdenvent_labels a skos:ConceptScheme ;
    rdfs:label "crowd-enVENT"@en,
        "crowd-enVENT のラベル"@ja ;
    dcterms:bibliographicCitation "Troiano, E., Oberlaender, L. and Klinger, R. (2023). Dimensional Modeling of Emotions in Text with Appraisal Theories: Corpus Creation, Annotation Reliability, and Prediction. Computational Linguistics 49(1), 1-72. doi:10.1162/coli_a_00461." ;
    dcterms:source <https://www.ims.uni-stuttgart.de/data/appraisalemotion> ;
    map:datasetKey "crowdenvent" ;
    map:intensityScale "writer self-rating, 1-5" ;
    map:labelCardinality "single" ;
    map:labellingMethod map:WriterChosen ;
    map:labelsCheckedIn "Paper, Section 3 (12 emotion labels and a no-emotion category). The values in the data files were not checked." .

map:NameVariantRule a owl:Class ;
    rdfs:label "Name Variant Rule"@en,
        "語形の規則"@ja ;
    skos:definition "A listed pair of an adjective or participle form and the Plutchik (2001) term it derives from; the only forms accepted as name variants."@en,
        "形容詞・分詞の形と、その元になる Plutchik (2001) の語の組。語形として認めるのは、ここに挙げたものだけ。"@ja .

map:goodnewseveryone_labels a skos:ConceptScheme ;
    rdfs:label "GoodNewsEveryone"@en,
        "GoodNewsEveryone のラベル"@ja ;
    dcterms:bibliographicCitation "Bostan, L. A. M., Kim, E. and Klinger, R. (2020). GoodNewsEveryone: A Corpus of News Headlines Annotated with Emotions, Semantic Roles, and Reader Perception. LREC 2020. arXiv:1912.03184." ;
    dcterms:source <https://www.ims.uni-stuttgart.de/data/goodnewseveryone> ;
    map:datasetKey "goodnewseveryone" ;
    map:intensityScale "low / medium / high" ;
    map:labelCardinality "single (dominant emotion)" ;
    map:labellingMethod map:ReaderAnnotated ;
    map:labelsCheckedIn "Label values of the gold dominant emotion in the released data (gne-release-v1.0.jsonl, 15 values), checked 2026-11-27. The paper (Section 3.4) lists the same 15 categories under shorter names (love, pessimism, optimism, negative surprise, positive surprise); the data name five of them as composites, and those are not mapped. The first annotation phase also offered 'No emotion', which is not one of the 15 categories." .

map:electoraltweets_labels a skos:ConceptScheme ;
    rdfs:label "Electoral Tweets (Questionnaire 2)"@en,
        "Electoral Tweets（質問票 2）のラベル"@ja ;
    dcterms:bibliographicCitation "Mohammad, S. M., Zhu, X., Kiritchenko, S. and Martin, J. (2015). Sentiment, emotion, purpose, and style in electoral tweets. Information Processing & Management 51(4), 480-499. doi:10.1016/j.ipm.2014.09.003." ;
    dcterms:source <https://saifmohammad.com/WebDocs/ElectoralTweetsData.zip> ;
    map:datasetKey "electoraltweets" ;
    map:intensityScale "low / medium / high" ;
    map:labelCardinality "single (per response)" ;
    map:labellingMethod map:ReaderAnnotated ;
    map:labelsCheckedIn "Annotation questionnaire in the data archive (19 options, 7 of them composite). The data files write one option with two spaces ('anticipation or  expectancy or interest'); the questionnaire spelling is used here. The paper itself was not read." .

map:ComponentMapping a owl:Class ;
    rdfs:label "Component Mapping"@en,
        "成分写像"@ja ;
    rdfs:subClassOf map:LabelMapping ;
    skos:definition "A label mapping that maps a label to one or two Plutchik basic emotions as its components."@en,
        "ラベルを 1〜2 個の基本感情の成分に写すラベル写像。"@ja .

map:goemotions_labels a skos:ConceptScheme ;
    rdfs:label "GoEmotions"@en,
        "GoEmotions のラベル"@ja ;
    dcterms:bibliographicCitation "Demszky, D., Movshovitz-Attias, D., Ko, J., Cowen, A., Nemade, G. and Ravi, S. (2020). GoEmotions: A Dataset of Fine-Grained Emotions. ACL 2020, 4040-4054." ;
    dcterms:source <https://github.com/google-research/google-research/tree/master/goemotions> ;
    map:datasetKey "goemotions" ;
    map:labelCardinality "multi" ;
    map:labellingMethod map:ReaderAnnotated ;
    map:labelsCheckedIn "Paper (27 emotion labels and neutral; three or five raters per example). Label list unchanged from release 0.5.0." .

map:empatheticdialogues_labels a skos:ConceptScheme ;
    rdfs:label "EmpatheticDialogues"@en,
        "EmpatheticDialogues のラベル"@ja ;
    dcterms:bibliographicCitation "Rashkin, H., Smith, E. M., Li, M. and Boureau, Y.-L. (2019). Towards Empathetic Open-domain Conversation Models: A New Benchmark and Dataset. ACL 2019. arXiv:1811.00207." ;
    dcterms:source <https://github.com/facebookresearch/EmpatheticDialogues> ;
    map:datasetKey "empatheticdialogues" ;
    map:labelCardinality "single" ;
    map:labellingMethod map:WriterChosen ;
    map:labelsCheckedIn "Paper, Figure 3 (32 emotion labels). The values in the data files were not checked." .

map:LimCheong2024 a owl:NamedIndividual,
        map:MappingScheme ;
    rdfs:label "Lim & Cheong (2024) mapping"@en,
        "Lim & Cheong (2024) の写像"@ja ;
    dcterms:bibliographicCitation "Lim, D. and Cheong, Y.-G. (2024). Integrating Plutchik's Theory with Mixture of Experts for Enhancing Emotion Classification. EMNLP 2024, 857-867; Table 1 (SemEval-2018) and Table 2 (GoEmotions)." ;
    skos:definition "The component mapping used by Lim & Cheong (2024); kept for reproducing CombineEFOMoE experiments."@en,
        "Lim & Cheong (2024) が使った成分写像。CombineEFOMoE の実験を再現するために残す。"@ja ;
    map:coversDataset map:goemotions_labels,
        map:semeval2018_labels .

map:UnmappedLabel a owl:Class ;
    rdfs:label "Unmapped Label"@en,
        "写さないラベル"@ja ;
    skos:definition "A record that a dataset label is not mapped under a scheme, with the reason."@en,
        "ある写像方式でデータセットのラベルを写さないことと、その理由の記録。"@ja .

map:ConceptMapping a owl:Class ;
    rdfs:label "Concept Mapping"@en,
        "概念写像"@ja ;
    rdfs:subClassOf map:LabelMapping ;
    skos:definition "A label mapping that maps a label to exactly one Plutchik emotion with a SKOS match type."@en,
        "ラベルを SKOS の対応の種類つきで Plutchik の感情 1 つに写すラベル写像。"@ja .

map:Plutchik2001Names a owl:NamedIndividual,
        map:MappingScheme ;
    rdfs:label "Plutchik (2001) names mapping"@en,
        "Plutchik (2001) の名前に基づく写像"@ja ;
    dcterms:bibliographicCitation "Plutchik, R. (2001). The Nature of Emotions. American Scientist 89(4), 344-350. Demszky, D. et al. (2020). GoEmotions: A Dataset of Fine-Grained Emotions. ACL 2020, 4040-4054; Ekman grouping from google-research/goemotions/data/ekman_mapping.json (retrieved 2026-11-14)." ;
    skos:definition "Maps each label to one Plutchik emotion (basic, intensity variant or dyad) by an identical name or by a listed adjective or participle form of the name (map:NameVariantRule). For GoEmotions only, labels without such a name fall back to the Demszky et al. (2020) Ekman grouping. Composite, qualified and non-emotion labels are not mapped; unmapped labels carry a reason. A match by name does not establish that the dataset label and the Plutchik emotion are the same concept."@en,
        "各ラベルを、名前の一致か、表に載る形容詞・分詞の形（map:NameVariantRule）で、Plutchik の感情（基本感情・強度の変種・dyad）1 つに写す。GoEmotions だけは、当たらないラベルに Demszky et al. (2020) の Ekman 対応を使う。複数の語をつないだラベル・限定のついたラベル・感情でないラベルは写さず、理由を記録する。名前の一致は、データセットのラベルと Plutchik の感情が同じ概念であることまでは示さない。"@ja ;
    map:coversDataset map:brighter_eng_labels,
        map:crowdenvent_labels,
        map:dailydialog_labels,
        map:electoraltweets_labels,
        map:empatheticdialogues_labels,
        map:enisear_labels,
        map:goemotions_labels,
        map:goodnewseveryone_labels,
        map:semeval2018_eioc_labels,
        map:semeval2018_labels,
        map:ssec_labels,
        map:xed_labels .

