map:ScoreThresholded a owl:NamedIndividual,
        map:LabellingMethod ;
    rdfs:label "score-thresholded"@en,
        "得点の区切り"@ja ;
    skos:definition "Classes obtained by cutting a continuous human-derived score into bands."@en,
        "人手に由来する連続の得点を区切って作ったクラス。"@ja .

